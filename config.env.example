# Copy this file to config.env and fill in your own values.
# config.env is gitignored — never commit your real values.

# Non-root sudo user the script will create/manage
NEW_USER=deploy

# SSH port. 22 = default, or set a custom port (must be allowed through
# your VM/cloud provider's own firewall too if you change it)
SSH_PORT=22

# Public key file to authorize for SSH (currently informational only —
# see "Known limitations" in the README)
SSH_KEY_PATH=~/.ssh/id_ed25519.pub

# Name of the docker-compose service monitored by the healthcheck timer
CONTAINER_NAME=web

# How often the healthcheck timer runs, in minutes
HEALTHCHECK_MIN=5
